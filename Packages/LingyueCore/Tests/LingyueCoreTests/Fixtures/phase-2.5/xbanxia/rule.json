{
  "id": "00000000-0000-0000-0000-000000005205",
  "schemaVersion": 1,
  "name": "半夏小说",
  "homepage": "https://www.xbanxia.cc/",
  "capabilities": {
    "supportsSearch": true,
    "showInSearchBar": true,
    "supportsBrowserImport": true,
    "requiresWebRender": false,
    "maxConcurrentRequests": 3,
    "requestIntervalMillis": 0
  },
  "enginePerStep": {
    "search": "http",
    "detail": "http",
    "catalog": "http",
    "chapter": "http"
  },
  "encoding": "auto",
  "defaultHeaders": {},
  "detection": {
    "hostPatterns": ["xbanxia.cc", "www.xbanxia.cc"],
    "pathPattern": "^/books/\\d+\\.html$",
    "confirmSelector": "h1, div.book-info"
  },
  "search": {
    "method": "post",
    "urlTemplate": "https://www.xbanxia.cc/modules/article/search_t.php",
    "bodyTemplate": "Submit=&searchkey={query}",
    "resultsSelector": "li.pop-book2",
    "titleField": {
      "selector": "h2.pop-tit",
      "transforms": [{ "trim": {} }]
    },
    "detailURLField": {
      "selector": "a[title]",
      "attribute": "href",
      "transforms": [
        { "regexReplace": { "pattern": "^http://www\\.xbanxia\\.cc", "replacement": "https://www.xbanxia.cc" } },
        { "absoluteURL": {} }
      ]
    },
    "authorField": {
      "selector": "span.pop-intro",
      "attribute": "title",
      "transforms": [{ "trim": {} }]
    }
  },
  "detail": {
    "titleField": {
      "selector": "h1",
      "transforms": [{ "trim": {} }]
    },
    "catalogURLField": {
      "selector": "link[rel=canonical]",
      "attribute": "href",
      "transforms": [{ "absoluteURL": {} }]
    }
  },
  "catalog": {
    "chaptersSelector": "div#list dd a, ul.chapter li a",
    "titleField": {
      "transforms": [{ "trim": {} }]
    },
    "urlField": {
      "attribute": "href",
      "transforms": [{ "absoluteURL": {} }]
    },
    "maxPages": 1
  },
  "chapter": {
    "titleField": {
      "selector": "h1",
      "transforms": [{ "trim": {} }]
    },
    "bodyField": {
      "selector": "div#content, div.content",
      "attribute": "html",
      "transforms": [
        { "brToNewline": {} },
        { "stripHTML": {} },
        { "decodeHTMLEntities": {} }
      ]
    },
    "maxBodyPages": 1
  }
}
