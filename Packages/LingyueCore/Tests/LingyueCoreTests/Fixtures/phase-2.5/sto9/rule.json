{
  "id": "00000000-0000-0000-0000-000000005709",
  "schemaVersion": 1,
  "name": "思兔閱讀",
  "homepage": "https://sto9.com/",
  "capabilities": {
    "supportsSearch": true,
    "showInSearchBar": true,
    "supportsBrowserImport": true,
    "requiresWebRender": false,
    "maxConcurrentRequests": 3,
    "requestIntervalMillis": 0
  },
  "enginePerStep": {
    "search": "http",
    "detail": "http",
    "catalog": "http",
    "chapter": "http"
  },
  "encoding": "auto",
  "defaultHeaders": {},
  "detection": {
    "hostPatterns": ["sto9.com"],
    "pathPattern": "^/book/\\d+\\.html$",
    "confirmSelector": "h1 a"
  },
  "search": {
    "method": "post",
    "urlTemplate": "https://sto9.com/search",
    "bodyTemplate": "searchkey={query}&searchtype=all",
    "resultsSelector": "ul#article_list_content > li",
    "titleField": {
      "selector": "h3 a",
      "transforms": [{ "trim": {} }]
    },
    "detailURLField": {
      "selector": "h3 a",
      "attribute": "href",
      "transforms": [{ "absoluteURL": {} }]
    },
    "authorField": {
      "selector": "div.labelbox label:first-of-type",
      "transforms": [{ "trim": {} }]
    },
    "coverField": {
      "selector": "a.imgbox img",
      "attribute": "data-src",
      "transforms": [{ "absoluteURL": {} }]
    },
    "snippetField": {
      "selector": "ol.ellipsis_2",
      "transforms": [{ "trim": {} }, { "collapseWhitespace": {} }]
    }
  },
  "detail": {
    "titleField": {
      "selector": "h1 a",
      "transforms": [{ "trim": {} }]
    },
    "catalogURLField": {
      "selector": "a[href*=\"/book/\"][href$=\"/index.html\"]",
      "attribute": "href",
      "transforms": [
        { "absoluteURL": {} },
        { "regexReplace": { "pattern": "/book/(\\d+)/index\\.html$", "replacement": "/ajax_novels/chapterlist/$1.html" } }
      ]
    }
  },
  "catalog": {
    "chaptersSelector": "li[data-num]",
    "titleField": {
      "selector": "a",
      "transforms": [{ "trim": {} }]
    },
    "urlField": {
      "selector": "a",
      "attribute": "href",
      "transforms": [{ "absoluteURL": {} }]
    },
    "maxPages": 1
  },
  "chapter": {
    "titleField": {
      "selector": "div.txtnav h1",
      "transforms": [{ "trim": {} }]
    },
    "bodyField": {
      "selector": "div.txtnav",
      "attribute": "html",
      "transforms": [
        { "brToNewline": {} },
        { "stripHTML": {} },
        { "decodeHTMLEntities": {} },
        { "collapseWhitespace": {} }
      ]
    },
    "maxBodyPages": 1
  }
}
