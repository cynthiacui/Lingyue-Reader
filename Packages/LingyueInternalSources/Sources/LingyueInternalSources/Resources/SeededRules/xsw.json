{
  "id": "00000000-0000-0000-0000-000000005207",
  "schemaVersion": 1,
  "name": "台灣小說網",
  "homepage": "https://www.xsw.tw/",
  "capabilities": {
    "supportsSearch": true,
    "showInSearchBar": true,
    "supportsBrowserImport": true,
    "requiresWebRender": false,
    "maxConcurrentRequests": 1,
    "requestIntervalMillis": 250
  },
  "enginePerStep": {
    "search": "http",
    "detail": "http",
    "catalog": "http",
    "chapter": "http"
  },
  "encoding": "auto",
  "defaultHeaders": {},
  "detection": {
    "hostPatterns": ["xsw.tw", "www.xsw.tw", "m.xsw.tw"],
    "pathPattern": "^/(?:book/)?\\d+(?:/(?:page-\\d+\\.html)?|\\.html)?$",
    "confirmSelector": "div.block_txt2 h2, div.liebiao, h1.f20h, h1, div.title h2"
  },
  "search": {
    "method": "get",
    "urlTemplate": "https://www.xsw.tw/modules/article/search.php?searchtype=articlename&searchkey={query}",
    "resultsSelector": "div#alistbox",
    "titleField": {
      "selector": "div.title h2 a",
      "transforms": [{ "trim": {} }]
    },
    "detailURLField": {
      "selector": "div.title h2 a",
      "attribute": "href",
      "transforms": [
        { "regexReplace": { "pattern": "^/book/(\\d+)\\.html$", "replacement": "https://m.xsw.tw/$1/" } },
        { "absoluteURL": {} }
      ]
    },
    "authorField": {
      "selector": "div.title span",
      "transforms": [
        { "regexCapture": { "pattern": "作者[：:]\\s*(\\S+)" } },
        { "trim": {} }
      ]
    },
    "snippetField": {
      "selector": "div.intro",
      "transforms": [
        { "stripHTML": {} },
        { "collapseWhitespace": {} },
        { "trim": {} }
      ]
    }
  },
  "detail": {
    "titleField": {
      "selector": "div.block_txt2 h2, h1.f20h, h1",
      "transforms": [
        { "regexReplace": { "pattern": "作者(?:：|:).*$", "replacement": "" } },
        { "trim": {} }
      ]
    },
    "catalogURLField": {
      "transforms": [
        { "useBaseURL": {} },
        { "regexReplace": { "pattern": "^https?://[^/]+/(?:book/)?(\\d+)(?:\\.html)?/?$", "replacement": "https://www.xsw.tw/book/$1/" } }
      ]
    }
  },
  "catalog": {
    "chaptersSelector": "div.liebiao > ul > li > a",
    "titleField": {
      "transforms": [
        { "stripHTML": {} },
        { "collapseWhitespace": {} },
        { "trim": {} }
      ]
    },
    "urlField": {
      "attribute": "href",
      "transforms": [
        { "absoluteURL": {} },
        { "regexReplace": { "pattern": "^https?://[^/]+/book/(\\d+)/(\\d+)\\.html$", "replacement": "https://m.xsw.tw/$1/$2.html" } }
      ]
    },
    "maxPages": 1
  },
  "chapter": {
    "titleField": {
      "selector": "div.nr_title, #nr_title",
      "transforms": [
        { "stripHTML": {} },
        { "collapseWhitespace": {} },
        { "trim": {} }
      ]
    },
    "bodyField": {
      "selector": "div#nr1",
      "attribute": "html",
      "transforms": [
        { "brToNewline": {} },
        { "stripHTML": {} },
        { "decodeHTMLEntities": {} }
      ]
    },
    "maxBodyPages": 1
  }
}
