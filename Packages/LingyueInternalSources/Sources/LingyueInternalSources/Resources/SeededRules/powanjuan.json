{
  "id": "00000000-0000-0000-0000-000000005402",
  "schemaVersion": 1,
  "name": "破万卷小说",
  "homepage": "https://www.powanjuan.cc/",
  "capabilities": {
    "supportsSearch": true,
    "showInSearchBar": true,
    "supportsBrowserImport": true,
    "requiresWebRender": false,
    "maxConcurrentRequests": 3,
    "requestIntervalMillis": 0
  },
  "enginePerStep": {
    "search": "http",
    "detail": "http",
    "catalog": "http",
    "chapter": "http"
  },
  "encoding": "gb18030",
  "defaultHeaders": {},
  "detection": {
    "hostPatterns": ["powanjuan.cc", "www.powanjuan.cc"],
    "pathPattern": "^/[a-z]+/\\d+(?:\\.html)?$",
    "confirmSelector": "div.info div.title strong, h1"
  },
  "search": {
    "method": "post",
    "urlTemplate": "https://www.powanjuan.cc/e/search/index.php",
    "bodyTemplate": "show=title&classid=0&keyboard={query}",
    "queryEncoding": "gb18030",
    "resultsSelector": "div.list > ul > li",
    "titleField": {
      "selector": "div.info div.title strong a",
      "transforms": [{ "trim": {} }]
    },
    "detailURLField": {
      "selector": "div.info div.title strong a",
      "attribute": "href",
      "transforms": [{ "absoluteURL": {} }]
    },
    "coverField": {
      "selector": "div.cover img",
      "attribute": "src",
      "transforms": [{ "absoluteURL": {} }]
    },
    "snippetField": {
      "selector": "div.descript a",
      "transforms": [
        { "brToNewline": {} },
        { "stripHTML": {} },
        { "collapseWhitespace": {} },
        { "trim": {} }
      ]
    }
  },
  "detail": {
    "titleField": {
      "selector": "h1, div.title strong",
      "transforms": [{ "trim": {} }]
    },
    "catalogURLField": {
      "selector": "link[rel=canonical]",
      "attribute": "href",
      "transforms": [{ "absoluteURL": {} }]
    }
  },
  "catalog": {
    "chaptersSelector": "ul.book_list > li, div.book_list a, ul.list > li",
    "titleField": {
      "selector": "a",
      "transforms": [{ "trim": {} }]
    },
    "urlField": {
      "selector": "a",
      "attribute": "href",
      "transforms": [{ "absoluteURL": {} }]
    },
    "maxPages": 1
  },
  "chapter": {
    "titleField": {
      "selector": "h1",
      "transforms": [{ "trim": {} }]
    },
    "bodyField": {
      "selector": "div#content, div.content, div#text",
      "attribute": "html",
      "transforms": [
        { "brToNewline": {} },
        { "stripHTML": {} },
        { "decodeHTMLEntities": {} }
      ]
    },
    "maxBodyPages": 1
  }
}
