{
  "id": "00000000-0000-0000-0000-000000005206",
  "schemaVersion": 1,
  "name": "努努书坊",
  "homepage": "https://www.nunucom.com/",
  "capabilities": {
    "supportsSearch": true,
    "showInSearchBar": true,
    "supportsBrowserImport": true,
    "requiresWebRender": false,
    "maxConcurrentRequests": 3,
    "requestIntervalMillis": 0
  },
  "enginePerStep": {
    "search": "http",
    "detail": "http",
    "catalog": "http",
    "chapter": "http"
  },
  "encoding": "auto",
  "defaultHeaders": {},
  "detection": {
    "hostPatterns": ["nunucom.com", "www.nunucom.com"],
    "pathPattern": "^/txt/\\d+\\.html$",
    "confirmSelector": "h1, div.book-info"
  },
  "search": {
    "method": "post",
    "urlTemplate": "https://www.nunucom.com/search/",
    "bodyTemplate": "searchkey={query}",
    "resultsSelector": "li:has(span.s2 a)",
    "titleField": {
      "selector": "span.s2 a",
      "transforms": [{ "trim": {} }]
    },
    "detailURLField": {
      "selector": "span.s2 a",
      "attribute": "href",
      "transforms": [{ "absoluteURL": {} }]
    },
    "authorField": {
      "selector": "span.s4",
      "transforms": [
        { "stripHTML": {} },
        { "collapseWhitespace": {} },
        { "trim": {} }
      ]
    },
    "snippetField": {
      "selector": "span.s3",
      "transforms": [
        { "stripHTML": {} },
        { "collapseWhitespace": {} },
        { "trim": {} }
      ]
    }
  },
  "detail": {
    "titleField": {
      "selector": "div.info h1, h1:not(.logo)",
      "transforms": [{ "trim": {} }]
    },
    "catalogURLField": {
      "selector": "link[rel=canonical]",
      "attribute": "href",
      "transforms": [{ "absoluteURL": {} }]
    }
  },
  "catalog": {
    "chaptersSelector": "h2.layout-tit:contains(正文) ~ div.section-box ul.section-list li a",
    "titleField": {
      "transforms": [{ "trim": {} }]
    },
    "urlField": {
      "attribute": "href",
      "transforms": [{ "absoluteURL": {} }]
    },
    "maxPages": 1
  },
  "chapter": {
    "titleField": {
      "selector": "h1",
      "transforms": [{ "trim": {} }]
    },
    "bodyField": {
      "selector": "div#content, div.content",
      "attribute": "html",
      "transforms": [
        { "brToNewline": {} },
        { "stripHTML": {} },
        { "decodeHTMLEntities": {} }
      ]
    },
    "maxBodyPages": 1
  }
}
